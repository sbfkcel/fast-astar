{
  "name": "fast-astar",
  "type": "module",
  "version": "2.0.0",
  "description": "fast-astar is an implementation of a* algorithm using javascript. Small and fast.",
  "files": [
    "astar.wasm",
    "wasm.js",
    "wasm.d.ts",
    "index.js",
    "Grid.js",
    "Astar.js"
  ],
  "main": "index.js",
